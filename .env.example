# Copy to .env (git-ignored) for docker compose / local runs. Every value maps to backend/src/main/resources/application.yml.

# --- required ---
# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# --- database ---
MONGO_URI=mongodb://localhost:27017/Ecommerce_2024

# --- payments: "fake" (local, no money moves) or "razorpay" ---
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- bootstrap admin (created once if missing; password >= 12 chars) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- invoices ---
# The DEFAULT store's seller details, for anything it has not set on its admin Store settings page. Other stores
# never use these. INVOICE_SELLER_STATE decides CGST+SGST (buyer in the same state) versus IGST;
# spell it the way customers type states ("Karnataka", not "KA").
INVOICE_SELLER_NAME=6Pack
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=
INVOICE_SELLER_STATE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=

# --- legal & consent (docs/foundations/compliance-consent.md) ---
# Effective date of the policy text users must have accepted. Bump only for a material change:
# every signed-in user is then asked to accept again before they can continue or check out.
LEGAL_TERMS_VERSION=2026-10-16
LEGAL_PRIVACY_VERSION=2026-10-16
LEGAL_ADMIN_AUP_VERSION=2026-10-18
# Salt for the hashed IP kept as proof of consent (openssl rand -base64 32). Set once; never change it.
CONSENT_IP_SALT=

# --- web ---
# Origins allowed by CORS (only needed when the SPA is NOT served via the same-origin proxy)
CLIENT_URL=http://localhost:5173
# Base URL used in password-reset links
FRONTEND_URL=http://localhost:5173

# --- shop rules: platform defaults; each store owner can set their own on the admin Store settings page ---
STORE_SHIPPING_FEE=200
STORE_FREE_SHIPPING_ABOVE=1000
STORE_DEFAULT_TAX_RATE=18
STORE_MAX_COUPON_AMOUNT=100000
# Never below 18.
STORE_MINIMUM_AGE=18
STORE_TIME_ZONE=Asia/Kolkata
PRODUCT_PER_PAGE=10
# Product variants (size, colour, ...). On by default; set false to stop admins creating new ones.
PRODUCT_VARIANTS_ENABLED=true
# Dev only: log password-reset links instead of emailing them
MAIL_LOG_LINKS=true

# --- observability ---
# Set true when running `docker compose --profile observability up`
TRACING_EXPORT_ENABLED=false
TRACING_SAMPLING_PROBABILITY=1.0
# Set to "ecs" for JSON logs (prod profile does this automatically)
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# --- tenancy (docs/superpowers/specs/2026-10-18-multitenancy-design.md) ---
# Only used the first time the app starts, to create the tenant that owns all existing data.
# With a single tenant every host resolves to it, so these can stay unset.
TENANT_DEFAULT_SLUG=default
TENANT_DEFAULT_NAME=6Pack
TENANT_DEFAULT_DOMAINS=localhost,127.0.0.1
# Offboarding: a closed store can be restored for this long, then its data and uploads are purged.
TENANT_DELETION_GRACE=30d
TENANT_PURGE_INTERVAL=1h
# A store created as a trial is suspended after this unless a platform admin activates it.
TENANT_TRIAL_LENGTH=14d
# Default limits per store (a platform admin can give a store its own). The request limit is per backend instance.
TENANT_MAX_PRODUCTS=5000
TENANT_MAX_UPLOADS=2GB
TENANT_REQUESTS_PER_MINUTE=600

# --- platform administrator (manages tenants; has no access to any store's data) ---
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
